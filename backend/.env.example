# Kopieren nach backend/.env und ausfüllen. backend/.env NIE committen.
MONGO_URI=mongodb+srv://USER:PASSWORT@cluster.example.mongodb.net/
DB_NAME=tracker
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
# Ohne abschließenden Slash
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:5000
# Komma-getrennte Liste. Nie "*" in Produktion (Cookies/Credentials sind aktiv).
CORS_ORIGINS=http://localhost:3000
# Optional: Feedback per Telegram (Bot bei @BotFather anlegen, Chat-ID siehe docs/DEPLOYMENT.md)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: Erinnerungen per Push am Handy. Schlüssel erzeugen: python ../tools/gen-vapid.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@trackyourcrew.de
# Optional: externer Wecker für Erinnerungen (Render Cron o. ä. ruft POST /api/cron/reminders mit Header X-Cron-Secret)
CRON_SECRET=
# Optional, nur für tools/gen-coach-voice.mjs (KI-Stimme des Sprachcoachs einmalig erzeugen). Der Server braucht ihn nicht.
OPENAI_API_KEY=
